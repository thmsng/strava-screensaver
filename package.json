{
  "name": "strava-screensaver",
  "version": "1.0.0",
  "description": "Screensaver that replays your Strava runs as ghost races on a map",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "settings": "electron . -c",
    "saver": "electron . -s --windowed",
    "web": "node server.js",
    "build": "node scripts/build.js",
    "package": "node scripts/package-release.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  }
}
